{
  "name": "@deeprush/cloudflare",
  "version": "26.729.60253",
  "description": "Small Cloudflare DNS API helper for DeepRush infrastructure scripts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xghini/deeprush-packages.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/xghini/deeprush-packages/tree/main/packages/cloudflare#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run test"
  },
  "keywords": [
    "cloudflare",
    "dns",
    "ddns",
    "deeprush"
  ],
  "author": "DeepRush",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
