{
  "name": "@deeprush/bctl",
  "version": "26.1007.190727",
  "description": "Reusable Playwright contexts, shared static caching, human interaction, and remote browser control.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xghini/deeprush-packages.git",
    "directory": "packages/bctl"
  },
  "homepage": "https://github.com/xghini/deeprush-packages/tree/main/packages/bctl#readme",
  "type": "module",
  "author": "DeepRush",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./default-context": {
      "types": "./dist/default-context.d.ts",
      "import": "./dist/default-context.js"
    },
    "./shared-context-cache": {
      "types": "./dist/shared-context-cache.d.ts",
      "import": "./dist/shared-context-cache.js"
    },
